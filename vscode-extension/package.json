{
  "name": "llm-box",
  "displayName": "llm-box",
  "description": "Build terminal workflows using plain English. Describe what you want, llm-box generates the YAML and executes it.",
  "version": "0.4.0",
  "publisher": "alib8b8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alib8b8/llm-box.git"
  },
  "homepage": "https://github.com/alib8b8/llm-box",
  "bugs": {
    "url": "https://github.com/alib8b8/llm-box/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Workflow",
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "workflow",
    "automation",
    "llm",
    "ai",
    "yaml",
    "terminal",
    "ollama",
    "openai",
    "deepseek"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onCommand:llm-box.createWorkflow",
    "onCommand:llm-box.runWorkflow",
    "onCommand:llm-box.validateWorkflow",
    "onCommand:llm-box.listNodes",
    "onCommand:llm-box.installNode",
    "onCommand:llm-box.uninstallNode",
    "onCommand:llm-box.registrySync",
    "onCommand:llm-box.registryList",
    "onCommand:llm-box.registrySearch",
    "onView:llm-box-explorer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llm-box.createWorkflow",
        "title": "llm-box: Create Workflow from Description",
        "category": "llm-box"
      },
      {
        "command": "llm-box.runWorkflow",
        "title": "llm-box: Run Workflow",
        "category": "llm-box"
      },
      {
        "command": "llm-box.validateWorkflow",
        "title": "llm-box: Validate Workflow",
        "category": "llm-box"
      },
      {
        "command": "llm-box.listNodes",
        "title": "llm-box: List Available Nodes",
        "category": "llm-box"
      },
      {
        "command": "llm-box.installNode",
        "title": "llm-box: Install Node",
        "category": "llm-box"
      },
      {
        "command": "llm-box.uninstallNode",
        "title": "llm-box: Uninstall Node",
        "category": "llm-box"
      },
      {
        "command": "llm-box.registrySync",
        "title": "llm-box: Registry Sync",
        "category": "llm-box"
      },
      {
        "command": "llm-box.registryList",
        "title": "llm-box: Registry List",
        "category": "llm-box"
      },
      {
        "command": "llm-box.registrySearch",
        "title": "llm-box: Registry Search",
        "category": "llm-box"
      },
      {
        "command": "llm-box.openWorkflowFile",
        "title": "llm-box: Open Workflow File",
        "category": "llm-box"
      },
      {
        "command": "llm-box.runCurrentFile",
        "title": "llm-box: Run Current Workflow File",
        "category": "llm-box",
        "icon": "$(play)"
      },
      {
        "command": "llm-box.validateCurrentFile",
        "title": "llm-box: Validate Current Workflow",
        "category": "llm-box",
        "icon": "$(check)"
      },
      {
        "command": "llm-box.refreshExplorer",
        "title": "Refresh",
        "category": "llm-box",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "llm-box-view",
          "title": "llm-box",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "llm-box-view": [
        {
          "id": "llm-box-explorer",
          "name": "Workflows"
        },
        {
          "id": "llm-box-nodes",
          "name": "Nodes"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "llm-box.refreshExplorer",
          "when": "view == llm-box-explorer",
          "group": "navigation"
        },
        {
          "command": "llm-box.createWorkflow",
          "when": "view == llm-box-explorer",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "llm-box.runCurrentFile",
          "when": "resourceFilename =~ /\\.ya?ml$/",
          "group": "navigation@1"
        },
        {
          "command": "llm-box.validateCurrentFile",
          "when": "resourceFilename =~ /\\.ya?ml$/",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "llm-box.runWorkflow",
          "when": "resourceFilename =~ /\\.ya?ml$/",
          "group": "llm-box@1"
        },
        {
          "command": "llm-box.validateWorkflow",
          "when": "resourceFilename =~ /\\.ya?ml$/",
          "group": "llm-box@2"
        }
      ]
    },
    "configuration": {
      "title": "llm-box",
      "properties": {
        "llm-box.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the llm-box executable. Leave empty to auto-detect from PATH."
        },
        "llm-box.safeMode": {
          "type": "boolean",
          "default": true,
          "description": "Run workflows in safe mode (disables execute node)."
        },
        "llm-box.outputChannel": {
          "type": "boolean",
          "default": true,
          "description": "Show workflow output in VS Code output channel."
        },
        "llm-box.language": {
          "type": "string",
          "enum": [
            "en",
            "zh",
            "ru",
            "fr",
            "ja",
            "ko",
            "es",
            "ar",
            "hi"
          ],
          "default": "en",
          "description": "Language for llm-box CLI output."
        }
      }
    },
    "languages": [
      {
        "id": "yaml",
        "extensions": [
          ".yaml",
          ".yml"
        ],
        "aliases": [
          "YAML",
          "yaml"
        ]
      }
    ],
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/workflows.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "test-compile": "tsc -p ./",
    "test": "npm run test-compile && node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "vsix": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^7.2.1",
    "ts-loader": "^9.5.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^10.7.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2"
  }
}
