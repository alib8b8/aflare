{
  "llm-box: Basic Workflow": {
    "prefix": "llm-box-basic",
    "description": "Basic llm-box workflow skeleton with name and steps",
    "body": [
      "name: ${1:my-workflow}",
      "description: ${2:What this workflow does}",
      "steps:",
      "  - node: ${3:fetch_url}",
      "    params:",
      "      ${4:url: \"https://example.com\"}"
    ]
  },
  "llm-box: Fetch URL": {
    "prefix": "llm-box-fetch-url",
    "description": "Fetch content from a URL using the fetch_url node",
    "body": [
      "- node: fetch_url",
      "  params:",
      "    url: \"${1:https://example.com}\"",
      "    mode: \"${2:text}\"",
      "    timeout: \"${3:30}\""
    ]
  },
  "llm-box: File Write": {
    "prefix": "llm-box-file-write",
    "description": "Write content to a file using the file_write node",
    "body": [
      "- node: file_write",
      "  params:",
      "    path: \"${1:output.txt}\"",
      "    mode: \"${2:write}\""
    ]
  },
  "llm-box: Execute Command": {
    "prefix": "llm-box-execute",
    "description": "Run a shell command using the execute node (disabled in safe mode)",
    "body": [
      "- node: execute",
      "  params:",
      "    command: \"${1:echo hello}\""
    ]
  },
  "llm-box: Transform": {
    "prefix": "llm-box-transform",
    "description": "Transform text using string operations (upper, lower, trim, ...)",
    "body": [
      "- node: transform",
      "  params:",
      "    operation: \"${1:upper|lower|trim|lines|words|chars|first_line|first_500|first_1000|summary}\""
    ]
  },
  "llm-box: HTTP Request": {
    "prefix": "llm-box-http-request",
    "description": "Make an HTTP request with custom method, headers and body",
    "body": [
      "- node: http_request",
      "  params:",
      "    url: \"${1:https://api.example.com/data}\"",
      "    method: \"${2:GET}\"",
      "    headers: \"${3:{\\\"Authorization\\\":\\\"Bearer TOKEN\\\"}}\"",
      "    body: \"${4:}\"",
      "    timeout: \"${5:30}\""
    ]
  },
  "llm-box: Notify": {
    "prefix": "llm-box-notify",
    "description": "Send a notification via stdout, stderr or webhook",
    "body": [
      "- node: notify",
      "  params:",
      "    channel: \"${1:stdout|stderr|webhook}\"",
      "    message: \"${2:Done!}\"",
      "    webhook_url: \"${3:}\""
    ]
  },
  "llm-box: LLM Summary": {
    "prefix": "llm-box-llm-summary",
    "description": "Fetch a URL, summarize with an LLM (ollama or deepseek), and write to a file",
    "body": [
      "name: llm-summary",
      "description: Fetch a URL, summarize it with an LLM, then save the summary",
      "steps:",
      "  - node: fetch_url",
      "    params:",
      "      url: \"${1:https://example.com/article}\"",
      "      mode: \"main_content\"",
      "  - node: ollama",
      "    params:",
      "      model: \"${2:llama3}\"",
      "      endpoint: \"http://localhost:11434\"",
      "      prompt: \"Summarize the following content:\\n\\n{{.steps[0].output}}\"",
      "  # Alternative: use the deepseek node instead of ollama",
      "  # - node: deepseek",
      "  #   params:",
      "  #     model: \"deepseek-chat\"",
      "  #     prompt: \"Summarize: {{.steps[0].output}}\"",
      "  - node: file_write",
      "    params:",
      "      path: \"${3:summary.md}\""
    ]
  }
}
