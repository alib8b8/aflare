{
  "id": "real-world/code-review-pipeline",
  "name": "code-review-pipeline",
  "version": "1.0.0",
  "description": "Hybrid code review pipeline combining deterministic rule-engine checks with LLM deep analysis, producing a markdown report.",
  "author": "aflare community",
  "category": "developer-tools",
  "tags": [
    "developer-tools",
    "code-review",
    "workflow",
    "real-world"
  ],
  "keywords": [
    "code-review",
    "static-analysis",
    "llm",
    "pipeline"
  ],
  "inputs": [
    {
      "name": "target_file",
      "type": "string",
      "required": false,
      "default": "internal/nodes/transform.go"
    },
    {
      "name": "focus",
      "type": "string",
      "required": false,
      "default": "all"
    },
    {
      "name": "severity",
      "type": "string",
      "required": false,
      "default": "medium"
    }
  ],
  "outputs": [
    {
      "name": "report",
      "type": "string"
    }
  ],
  "dependencies": null
}
