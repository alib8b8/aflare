{
  "id": "real-world/log-anomaly-detector",
  "name": "log-anomaly-detector",
  "version": "1.0.0",
  "description": "Detect log anomalies: read logs, filter errors, branch on critical patterns via if/else, run root-cause agent on anomalies, and notify.",
  "author": "aflare community",
  "category": "devops-monitoring",
  "tags": [
    "devops-monitoring",
    "log-analysis",
    "condition",
    "workflow",
    "real-world"
  ],
  "keywords": [
    "log-anomaly",
    "sre",
    "conditional-branch",
    "alerting"
  ],
  "inputs": [
    {
      "name": "log_path",
      "type": "string",
      "required": false,
      "default": "examples/real-world/log-anomaly-detector/sample.log"
    },
    {
      "name": "critical_pattern",
      "type": "string",
      "required": false,
      "default": "panic|FATAL|OOM|out of memory|segfault"
    }
  ],
  "outputs": [
    {
      "name": "report",
      "type": "string"
    }
  ],
  "dependencies": null
}
