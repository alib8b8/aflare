{
  "id": "real-world/doc-extractor",
  "name": "doc-extractor",
  "version": "1.0.0",
  "description": "Fetch a web document, use an agent with json_parse + template_render tools to extract structured fields, validate the JSON, and render a summary.",
  "author": "llm-box community",
  "category": "data-processing",
  "tags": [
    "data-processing",
    "document",
    "extraction",
    "workflow",
    "real-world"
  ],
  "keywords": [
    "document-extraction",
    "json",
    "agent",
    "web-scraping"
  ],
  "inputs": [
    {
      "name": "source_url",
      "type": "string",
      "required": false,
      "default": "https://raw.githubusercontent.com/alib8b8/llm-box/main/README.md"
    },
    {
      "name": "extraction_schema",
      "type": "json",
      "required": false,
      "default": "{\"title\":\"\",\"summary\":\"\",\"key_features\":[],\"install_cmd\":\"\"}"
    }
  ],
  "outputs": [
    {
      "name": "json",
      "type": "string"
    }
  ],
  "dependencies": null
}
